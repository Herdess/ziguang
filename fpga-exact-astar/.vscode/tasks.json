{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Competition estimate",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build_windows.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Test Competition Submission",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tests\\test_windows.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Competition estimate",
      "problemMatcher": []
    },
    {
      "label": "Package Windows Submission Example",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\package_submission_windows.ps1"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Test Competition Submission",
      "problemMatcher": []
    }
  ]
}
